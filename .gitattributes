# Normalise line endings so Windows and Linux (CI) checkouts produce identical diffs.
* text=auto eol=lf

# Windows-only script types keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary
*.pdf binary
