<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nodeable.Domain\Nodeable.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SignalR's Hub and IHubContext are part of the ASP.NET Core shared framework. The hub class lives here so the Api
         (which hosts it) and the Worker (which sends to it through the Redis backplane) share one type. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers such as the search phrase quoting. -->
    <InternalsVisibleTo Include="Nodeable.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The resilience pipeline. Typed HttpClient registration and options binding come from the ASP.NET Core shared framework. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- The backplane that carries a message sent in the Worker to the Api process that holds the browser's connection. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- SuppressInstrumentationScope, to keep the queue's own polling out of the trace list. Every service already
         has the SDK through ServiceDefaults, so this adds nothing to what is deployed. -->
    <PackageReference Include="OpenTelemetry" />
    <!-- The rate gate talks to Redis directly. The services get their connection from Aspire's AddRedisClient. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
