<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Secrets go in dotnet user secrets, never in the repo (NFR-SEC-01). The MusicBrainz contact is a public URL, so it is plain configuration. -->
    <UserSecretsId>dotnet-Nodeable.Worker-cfe6d965-a75c-4640-97bc-ec747688f729</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodeable.ServiceDefaults\Nodeable.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Nodeable.Infrastructure\Nodeable.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- AddRedisClient("redis"): the connection string comes from the AppHost's WithReference(redis). -->
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <!-- The Hangfire server and its PostgreSQL storage: recurring jobs such as the 30-day cache refresh (NFR-REL-03, decision 0028). -->
    <PackageReference Include="Hangfire.NetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- Hangfire.Core asks for Newtonsoft.Json 11.0.1, which has an advisory; the pin in Directory.Packages.props lifts it. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
