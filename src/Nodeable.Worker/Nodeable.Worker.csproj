    <UserSecretsId>dotnet-Nodeable.Worker-cfe6d965-a75c-4640-97bc-ec747688f729</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodeable.ServiceDefaults\Nodeable.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Nodeable.Infrastructure\Nodeable.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddRedisClient("redis"): the connection string comes from the AppHost's WithReference(redis). -->
    <PackageReference Include="Aspire.StackExchange.Redis" />
  </ItemGroup>

</Project>
