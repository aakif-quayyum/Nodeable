<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nodeable.Api\Nodeable.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- A real SignalR client, connected to the Api in memory, to test the hub end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <!-- The search endpoint talks to MusicBrainz through the real client pipeline; WireMock stands in for MusicBrainz. -->
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared source file per container, compiled into every test project that needs it. -->
    <Compile Include="..\Shared\PostgresFixture.cs" Link="PostgresFixture.cs" />
    <Compile Include="..\Shared\RedisFixture.cs" Link="RedisFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real MusicBrainz responses the Infrastructure tests use: one copy, linked, so the two cannot drift apart. -->
    <None Include="..\Nodeable.Infrastructure.Tests\Fixtures\musicbrainz\*.json" Link="Fixtures\musicbrainz\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
